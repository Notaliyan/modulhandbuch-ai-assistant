# Backend build context excludes.
# Keep the image small and never bake in secrets or local-only state.

# Virtual environments
.venv/
venv/
env/

# Python caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets — the OpenAI key is injected at runtime via env_file, never copied
.env
.env.*

# The source PDF (data/docs/) IS copied into the image so a cloud deploy
# can build its own vector store on first boot. Only the generated store
# and any local .env are kept out.
data/chroma/
data/**/.env

# Tooling / VCS
.git/
.gitignore
.idea/
.vscode/
*.log
