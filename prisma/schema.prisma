// =============================================================================
// prisma/schema.prisma
// Enterprise RAG Engine — PostgreSQL 16 + pgvector
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector", schema: "public")]
}

// =============================================================================
// ENUMS
// =============================================================================

/// Lifecycle state of an ingested document through the RAG pipeline.
enum ProcessingStatus {
  PROCESSING // File received; text extraction and chunking in progress
  READY      // All chunks embedded and indexed; available for search
  FAILED     // Terminal error during ingestion — see Document.errorMessage
}

/// Coarse role for access-control decisions.
enum UserRole {
  STUDENT
  FACULTY
  ADMIN
}

// =============================================================================
// USER
// Lightweight authentication context. Extend with Clerk / NextAuth fields
// as your auth strategy requires — the id is the stable foreign-key anchor.
// =============================================================================

model User {
  id    String @id @default(cuid())

  /// Primary identifier used by the auth provider (email or sub claim)
  email String @unique @db.VarChar(320)

  /// Display name shown in the UI
  name  String? @db.VarChar(256)

  /// Profile avatar URL (populated by OAuth provider or manually set)
  avatarUrl String? @db.Text

  /// Access-control role
  role UserRole @default(STUDENT)

  /// Timestamp of the most recent successful sign-in
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  documents Document[]

  @@index([email])
  @@map("users")
}

// =============================================================================
// DOCUMENT
// Represents one uploaded module handbook PDF file.
// =============================================================================

model Document {
  id String @id @default(cuid())

  /// Sanitized filename used for storage and display
  filename String @db.VarChar(512)

  /// Original filename exactly as the user uploaded it
  originalName String @db.VarChar(512)

  /// MIME type, e.g. "application/pdf"
  mimeType String @default("application/pdf") @db.VarChar(128)

  /// File size in bytes
  fileSize Int?

  /// Total page count extracted from the PDF
  totalPages Int?

  /// Total number of text chunks produced during ingestion
  totalChunks Int?

  /// Current state in the ingestion pipeline
  processingStatus ProcessingStatus @default(PROCESSING)

  /// Human-readable error detail when processingStatus = FAILED
  /// Truncated to 1000 characters before storage.
  errorMessage String? @db.Text

  /// Optional FK to the user who uploaded this document
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  chunks DocumentChunk[]

  @@index([processingStatus])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("documents")
}

// =============================================================================
// DOCUMENT CHUNK
// One semantically coherent text passage extracted from a Document.
//
// ─── VECTOR EMBEDDING COLUMN ─────────────────────────────────────────────────
//
//  Prisma does not have a native scalar for pgvector's `vector` type, so the
//  `embedding` column is intentionally omitted from this schema file. It is
//  managed exclusively through raw SQL.
//
//  STEP 1 — After running `prisma migrate dev --create-only`, open the newly
//  generated migration file under prisma/migrations/…/migration.sql and append
//  the following SQL before applying it:
//
//    -- Enable pgvector (idempotent)
//    CREATE EXTENSION IF NOT EXISTS vector;
//
//    -- Add 1536-dimension embedding column (text-embedding-3-small output size)
//    ALTER TABLE "document_chunks"
//      ADD COLUMN IF NOT EXISTS embedding vector(1536);
//
//    -- HNSW index for sub-millisecond approximate nearest-neighbour search
//    -- m=16 and ef_construction=64 are safe defaults; tune for your data size.
//    CREATE INDEX IF NOT EXISTS document_chunks_embedding_hnsw_idx
//      ON "document_chunks"
//      USING hnsw (embedding vector_cosine_ops)
//      WITH (m = 16, ef_construction = 64);
//
//  STEP 2 — Apply the migration:
//    prisma migrate dev
//
//  ─── RUNTIME USAGE ───────────────────────────────────────────────────────────
//
//  WRITE (after inserting a chunk row):
//    import { Prisma } from "@prisma/client";
//    const vec = `[${float32Array.join(",")}]`;
//    await prisma.$executeRaw(
//      Prisma.sql`UPDATE document_chunks
//                 SET    embedding = ${vec}::vector
//                 WHERE  id        = ${chunkId}`
//    );
//
//  READ (cosine similarity — lower distance = more similar):
//    const vec = `[${queryEmbedding.join(",")}]`;
//    const rows = await prisma.$queryRaw<{ id: string; content: string; pageNumber: number; similarity: number }[]>(
//      Prisma.sql`
//        SELECT   id,
//                 content,
//                 "pageNumber",
//                 ROUND(CAST(1 - (embedding <=> ${vec}::vector) AS NUMERIC), 4) AS similarity
//        FROM     document_chunks
//        WHERE    embedding IS NOT NULL
//        ORDER BY embedding <=> ${vec}::vector
//        LIMIT    4`
//    );
//
// =============================================================================

model DocumentChunk {
  id String @id @default(cuid())

  /// Parent document
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Raw extracted text of this chunk (preserved exactly as parsed from the PDF)
  content String @db.Text

  /// 1-based page number in the source PDF — used for inline [Page N] citations
  pageNumber Int

  /// 0-based sequential position of this chunk within its document
  chunkIndex Int

  /// Approximate token count for GPT context-window budget tracking
  /// Estimated as ceil(charCount / 4) — replace with tiktoken for precision.
  tokenCount Int?

  /// Embedding model that produced the vector, e.g. "text-embedding-3-small"
  embeddingModel String? @db.VarChar(128)

  /// Timestamp when the embedding was generated (null until embedding is written)
  embeddedAt DateTime?

  createdAt DateTime @default(now())

  // NOTE: The `embedding vector(1536)` column lives outside this schema.
  // See the migration instructions in the block comment above.

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([pageNumber])
  @@map("document_chunks")
}